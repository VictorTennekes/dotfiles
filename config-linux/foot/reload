#!/bin/sh
# Start a fresh `foot --server` and make running windows follow a changed
# foot.ini. The compositors run this at login; Noctalia's foot template calls
# it after rendering themes/noctalia (several times per wallpaper change).
#
# foot reads its config once and a server keeps that copy for every
# footclient, so a server has to be replaced. Each server listens on its own
# socket (foot unlinks only that one when it exits), and the path footclient
# uses is a symlink swapped onto the new socket once it listens: at no point
# is there nothing to connect to, and a second run moments later only retires
# the server the first one started. Open windows stay on their old server,
# which a background loop kills once they are all closed; they are recoloured
# through OSC escapes so the switch is immediate.
set -eu

theme="${XDG_CONFIG_HOME:-$HOME/.config}/foot/themes/noctalia"
sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/foot-${WAYLAND_DISPLAY:-wayland-0}.sock"
new="$sock.$$"

# Recolour the windows of the server with pid $1 from the theme file
recolour() {
	[ -r "$theme" ] || return 0
	# OSC 10/11/12 (foreground, background, cursor) and OSC 4 (palette), each
	# ended by BEL; "cursor=" holds the text colour first, the cursor colour second
	seq=""
	while IFS='=' read -r key val; do
		case $key in
		foreground) seq="$seq\033]10;#${val%% *}\a" ;;
		background) seq="$seq\033]11;#${val%% *}\a" ;;
		cursor) seq="$seq\033]12;#${val##* }\a" ;;
		regular[0-7]) seq="$seq\033]4;${key#regular};#${val%% *}\a" ;;
		bright[0-7]) seq="$seq\033]4;$((${key#bright} + 8));#${val%% *}\a" ;;
		esac
	done <"$theme"
	# Every process the server forked is a window's shell; fd 0 is its pty
	for shell in $(pgrep -P "$1" 2>/dev/null); do
		pty=$(readlink "/proc/$shell/fd/0" 2>/dev/null) || continue
		case $pty in /dev/pts/*) printf '%b' "$seq" >"$pty" 2>/dev/null || true ;; esac
	done
}

# Every listening foot server (the new one isn't up yet)
old=$(ss -xlpH 2>/dev/null | grep -F "$sock" | sed -n 's/.*pid=\([0-9]*\),.*/\1/p' | sort -u)

setsid -f foot --server="$new" >/dev/null 2>&1
i=0
while [ ! -S "$new" ]; do
	i=$((i + 1))
	[ "$i" -le 50 ] || { echo "foot --server did not come up" >&2; exit 1; }
	sleep 0.1
done
# rename(2) replaces whatever is at the path (a symlink, or a socket from a
# server started the old way) in one step
ln -s "$new" "$sock.tmp.$$" && mv -T "$sock.tmp.$$" "$sock"

for pid in $old; do
	recolour "$pid"
	# Retire it once its last window is gone. A server started the old way
	# unlinks the shared path when it exits, taking the symlink with it:
	# put the symlink back, pointing at the newest socket.
	# shellcheck disable=SC2016
	setsid -f sh -c '
		while [ -d "/proc/$1" ] && ss -xpH state established 2>/dev/null | grep -q "pid=$1,"; do
			sleep 10
		done
		kill "$1" 2>/dev/null; sleep 1
		[ -e "$2" ] || { newest=$(ls -t "$2".[0-9]* 2>/dev/null | head -n1); [ -n "$newest" ] && ln -s "$newest" "$2"; }
	' reap "$pid" "$sock"
done
