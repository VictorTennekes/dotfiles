# Linux / Umbriel part of the Ghostty config (the shared part: config/ghostty/config).
# Colours from Noctalia's Ghostty template (themes/noctalia, gitignored).
theme = noctalia
font-size = 11

# Umbriel draws the borders; no GTK title bar.
window-decoration = none
# One process for all windows: new windows open instantly and share memory.
gtk-single-instance = true
# Keep the instance alive briefly after the last window closes, then exit.
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 5m
confirm-close-surface = false
