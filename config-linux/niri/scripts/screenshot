#!/usr/bin/env bash
# macOS-style screenshots: saved to ~/Screenshots and copied to the clipboard.
#   screen = whole monitor (Alt+Shift+3), region = drag a box (Alt+Shift+4),
#   edit = region, then annotate in satty (Alt+Shift+5)
set -euo pipefail
dir="$HOME/Screenshots"; mkdir -p "$dir"
file="$dir/Screenshot $(date '+%Y-%m-%d at %H.%M.%S').png"

# Esc while selecting a region cancels quietly
region() { slurp -d -b 1e1e2e66 -c cba6f7 || exit 0; }

case "${1:-region}" in
  screen) grim -o "$(niri msg --json focused-output | jq -r .name)" "$file" ;;
  region) geom=$(region); grim -g "$geom" "$file" ;;
  edit)   geom=$(region); grim -g "$geom" - |
            satty --filename - --output-filename "$file" --copy-command wl-copy --early-exit
          exit 0 ;;
esac

wl-copy < "$file"
notify-send -a Screenshot -i "$file" "Screenshot saved" "${file/#$HOME/\~}"
