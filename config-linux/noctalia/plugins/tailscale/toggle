#!/usr/bin/env bash
# Connect or disconnect Tailscale (the bar widget's click, widget.luau).
# tailscaled only runs while connected: this starts/stops it (a polkit rule,
# system-linux/polkit, allows that without a password), and tailscale itself
# needs no sudo because this user is the Tailscale operator.
if [[ $(tailscale status --json 2>/dev/null | jq -r .BackendState) == Running ]]; then
  tailscale down
  systemctl stop tailscaled
else
  systemctl start tailscaled
  for _ in {1..20}; do tailscale status --json >/dev/null 2>&1 && break; sleep 0.25; done
  tailscale up --operator="$USER"
fi
