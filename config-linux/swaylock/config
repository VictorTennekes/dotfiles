# Catppuccin Mocha lock screen (swaylock reads ~ in image paths)
image=~/Pictures/Wallpapers/current
scaling=fill
color=1e1e2e

font=JetBrainsMono Nerd Font
indicator-radius=140
indicator-thickness=10
# Show the ring right away, not only once you start typing
indicator-idle-visible
show-failed-attempts
ignore-empty-password

# Ring: peach idle, mauve on keypress (the two colors of the niri border; swaylock
# has no gradients), red on backspace/fail, yellow verifying
inside-color=1e1e2e99
ring-color=fab387
key-hl-color=cba6f7
bs-hl-color=f38ba8
text-color=cdd6f4
inside-clear-color=1e1e2ecc
ring-clear-color=a6e3a1
text-clear-color=a6e3a1
inside-ver-color=1e1e2ecc
ring-ver-color=f9e2af
text-ver-color=f9e2af
inside-wrong-color=1e1e2ecc
ring-wrong-color=f38ba8
text-wrong-color=f38ba8
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
separator-color=00000000
