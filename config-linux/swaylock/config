# Catppuccin Mocha lock screen (swaylock reads ~ in image paths)
image=~/Pictures/Wallpapers/current
scaling=fill
color=1e1e2e

font=JetBrainsMono Nerd Font
indicator-radius=140
indicator-thickness=10
indicator-idle-visible
ignore-empty-password

# Peach ring, mauve on keypress (the niri border colors; swaylock has no
# gradients). Yellow while checking, red when wrong. Every state shares the
# translucent inside.
inside-color=1e1e2e99
inside-clear-color=1e1e2e99
inside-ver-color=1e1e2e99
inside-wrong-color=1e1e2e99
ring-color=fab387
ring-clear-color=fab387
ring-ver-color=f9e2af
ring-wrong-color=f38ba8
key-hl-color=cba6f7
bs-hl-color=f38ba8
text-color=cdd6f4
text-clear-color=cdd6f4
text-ver-color=f9e2af
text-wrong-color=f38ba8
line-uses-inside
separator-color=00000000
