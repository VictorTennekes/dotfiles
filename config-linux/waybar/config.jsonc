{
  "layer": "top",
  "position": "top",
  "height": 30,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 6,
  "reload_style_on_change": true,

  "modules-left": ["niri/workspaces", "niri/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "tray",
    "group/hardware",
    "custom/tailscale",
    "bluetooth",
    "network",
    "pulseaudio",
    "group/power",
    "custom/notification"
  ],

  // niri workspaces are dynamic: there's always one empty one at the end
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": { "default": "○", "active": "●" },
    "on-scroll-up": "niri msg action focus-workspace-up",
    "on-scroll-down": "niri msg action focus-workspace-down"
  },

  "niri/window": {
    "max-length": 50,
    "separate-outputs": true
  },

  // macOS menu bar style: "Fri 8:24 PM"; hover for the date, click for a calendar
  "clock": {
    "format": "{:%a %I:%M %p}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "format": {
        "months": "<span color='#cba6f7'><b>{}</b></span>",
        "weekdays": "<span color='#89b4fa'><b>{}</b></span>",
        "weeks": "<span color='#6c7086'>W{}</span>",
        "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
      }
    }
  },

  "tray": { "icon-size": 15, "spacing": 8 },

  // Collapsed by default: click the chip to show CPU / memory / temperature
  "group/hardware": {
    "orientation": "horizontal",
    "drawer": { "transition-duration": 250, "click-to-reveal": true, "transition-left-to-right": false },
    "modules": ["custom/hw", "cpu", "memory", "temperature"]
  },
  "custom/hw": { "format": "󰵆", "tooltip-format": "Hardware (click)" },
  "cpu": { "interval": 10, "format": "󰻠 {usage}%", "on-click": "footclient btop" },
  "memory": { "interval": 30, "format": "󰍛 {percentage}%", "tooltip-format": "{used:0.1f}G / {total:0.1f}G" },
  "temperature": { "interval": 10, "format": "󰔏 {temperatureC}°", "critical-threshold": 90 },

  // Battery with the power profile tucked behind it: click the battery to
  // slide the profile icon out, then click that to cycle profiles
  "group/power": {
    "orientation": "horizontal",
    "drawer": { "transition-duration": 250, "click-to-reveal": true, "transition-left-to-right": false },
    "modules": ["battery", "power-profiles-daemon"]
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "format-icons": {
      "default": "󰾅",
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰾆"
    }
  },

  // Click to connect/disconnect (no sudo: this user is the Tailscale operator)
  "custom/tailscale": {
    "exec": "~/.config/waybar/scripts/tailscale",
    "on-click": "~/.config/waybar/scripts/tailscale toggle",
    "return-type": "json",
    "interval": 30,
    "signal": 8
  },

  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias} {device_battery_percentage}%",
    "tooltip-format-off": "Bluetooth off (right-click to turn on)",
    // Radio is off at boot; right-click toggles it, left-click opens bluetoothctl
    "on-click": "footclient --app-id=org.tui.floating bluetoothctl",
    "on-click-right": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on"
  },

  "network": {
    "format-wifi": "{icon}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 10,
    "on-click": "footclient --app-id=org.tui.floating nmtui"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": { "headphone": "󰋋", "default": ["󰕿", "󰖀", "󰕾"] },
    "tooltip-format": "{desc}: {volume}%",
    "scroll-step": 5,
    "on-click": "footclient --app-id=org.tui.floating wiremix",
    "on-click-right": "swayosd-client --output-volume mute-toggle"
  },

  "battery": {
    "interval": 30,
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}\n{power:.1f} W"
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚<span foreground='#f38ba8'><sup>●</sup></span>",
      "none": "󰂚",
      "dnd-notification": "󰂛<span foreground='#f38ba8'><sup>●</sup></span>",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}
