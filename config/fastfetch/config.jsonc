{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Max Theorum logo as shape-matched ASCII; `ff` swaps in logo.png (logo.svg
  // filled with Mocha text #cdd6f4: `sips -s format png -Z 512`) in local Ghostty
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "39" },
    "padding": { "top": 1, "right": 4 }
  },
  "display": {
    "separator": " ",
    "color": { "keys": "90" }
  },
  // Catnap-style box (preset examples/13); 16 rows, the logo floats in the middle
  "modules": [
    { "type": "custom", "key": "╭───────────╮" },
    { "type": "title", "key": "│ {#34}{#} user    {#keys}│", "format": "{user-name}@{host-name}" },
    { "type": "uptime", "key": "│ {#34}󰅐{#} uptime  {#keys}│" },
    { "type": "os", "key": "│ {#35}{icon}{#} os      {#keys}│", "format": "{pretty-name}" },
    { "type": "kernel", "key": "│ {#35}󰒓{#} kernel  {#keys}│" },
    { "type": "packages", "key": "│ {#35}󰏖{#} pkgs    {#keys}│" },
    { "type": "wm", "key": "│ {#35}󰇄{#} wm      {#keys}│" },
    { "type": "terminal", "key": "│ {#35}󰆍{#} term    {#keys}│" },
    { "type": "shell", "key": "│ {#35}{#} shell   {#keys}│" },
    { "type": "cpu", "key": "│ {#32}󰻠{#} cpu     {#keys}│" },
    { "type": "memory", "key": "│ {#32}󰍛{#} memory  {#keys}│" },
    { "type": "disk", "key": "│ {#32}󰉉{#} disk    {#keys}│", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "battery", "key": "│ {#32}󰂄{#} battery {#keys}│", "format": "{capacity} ({status})" },
    { "type": "custom", "key": "├───────────┤" },
    { "type": "colors", "key": "│ {#33}󰏘{#} colors  {#keys}│", "symbol": "circle" },
    { "type": "custom", "key": "╰───────────╯" }
  ]
}
