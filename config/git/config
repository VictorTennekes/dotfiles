[alias]
	br = branch --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(contents:subject) %(color:green)(%(committerdate:relative)) [%(authorname)]' --sort=-committerdate
	ci = commit
	st = status
	cm = commit -m
	sw = switch
	swc = "!f() { \
        git show-ref --verify --quiet refs/heads/$1 && git switch $1 || git switch -c $1; \
    }; f"
	cb = "!f() { \
		git commit -m \"$(git branch --show-current): $1\"; \
	}; f"
	acm = !git add -u && git cm
	acb = !git add -u && git cb
	plob = !git pull origin $(git branch --show-current)
	last = log -1 HEAD
	unstage = reset HEAD --
	ll = log --oneline

[init]
    defaultBranch = main

[transfer]
    fsckobjects = true

[push]
    default = simple
    autoSetupRemote = true
    followTags = true

[pull]
    rebase = true

[fetch]
    prune = true

[rebase]
    autoStash = true
    missingCommitsCheck = error
    # Stacked branches: rebasing the top one moves the ones below it too
    updateRefs = true

[rerere]
    enabled = true

[branch]
    sort = -committerdate

[column]
    ui = auto

[core]
	editor = nvim
	excludesfile = ~/.config/git/ignore
	pager = delta
	fsmonitor = false
	# Caches untracked-file scans: faster `git status` (and the prompt), no daemon
	untrackedCache = true

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	# Syntax colours by ANSI index (like BAT_THEME), so diffs follow the
	# terminal palette; base16 also uses the bright colours (dim comments)
	syntax-theme = base16

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default
	algorithm = histogram

[color]
	ui = auto

[commit]
	gpgsign = true
	verbose = true

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

# Per machine (scripts/setup writes them to ~/.gitconfig.local): user.signingkey
# and the gh credential helper, which needs gh's absolute path (GUI apps on
# macOS lack Homebrew on PATH, and the path differs per OS).
[user]
	email = 19930858+VictorTennekes@users.noreply.github.com

# Include local config
[include]
    path = ~/.gitconfig.local
