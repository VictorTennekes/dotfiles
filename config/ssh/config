# Included from the top of ~/.ssh/config (scripts/setup adds the Include line),
# so these win over anything later in that file. Machine-specific hosts stay
# in ~/.ssh/config itself.
#
# Git hosts use the Secretive "daily" key (Touch ID per use). SSH/phone
# sessions override this with the "remote" key via GIT_SSH_COMMAND
# (config/zsh/config/ssh.zsh). The .pub files are links into Secretive's
# store; the private keys never leave the Secure Enclave.
Host github.com gitlab.com
  User git
  IdentityAgent ~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh
  IdentityFile ~/.ssh/secretive-daily.pub
  IdentitiesOnly yes
