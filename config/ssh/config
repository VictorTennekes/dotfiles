# Included from the top of ~/.ssh/config (scripts/setup adds the Include line),
# so these win over anything later in that file. Machine-specific hosts stay
# in ~/.ssh/config itself.
#
# Git hosts use the Secretive agent. No IdentityFile here on purpose:
# ssh_config IdentityFile entries accumulate with `-i`, so pinning "daily"
# here would make it offered first even when SSH/phone sessions ask for
# "remote" (config/zsh/config/ssh.zsh), triggering an unanswerable Touch ID
# prompt. Locally the agent offers "daily" first (Touch ID).
Host github.com gitlab.com
  User git
  IdentityAgent ~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh
