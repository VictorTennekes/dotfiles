# Clipboard copy: OSC 52 over SSH (reaches the local terminal), else pbcopy
# (macOS) or wl-copy (Wayland).
# With a file argument: copy that file's contents.
# Otherwise: read from stdin.
local _copy
if [[ -n "$SSH_TTY" || -n "$SSH_CLIENT" ]]; then
  _osc52_copy() {
    local b64=$(base64)
    printf "\e]52;c;%s\a" "${b64//[$'\n\r']}"
  }
  _copy=(_osc52_copy)
else
  (( $+commands[pbcopy] )) && _copy=(pbcopy) || _copy=(wl-copy)
fi

if [[ $# -gt 0 ]]; then
  if [[ -f "$1" ]]; then
    "${_copy[@]}" < "$1" && echo "Copied contents of '$1' to clipboard."
  else
    echo "Error: '$1' is not a valid file." >&2
    return 1
  fi
else
  "${_copy[@]}" && echo "Copied from stdin to clipboard."
fi
