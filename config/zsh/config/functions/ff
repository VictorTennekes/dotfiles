# fastfetch with the Max Theorum logo as an image in local Ghostty (kitty-direct
# passes a file path, so not over SSH; foot has no kitty protocol); logo.txt elsewhere.
[[ $TERM == xterm-ghostty && -z $SSH_CONNECTION ]] || { fastfetch "$@"; return }
fastfetch --logo ~/.config/fastfetch/logo.png --logo-type kitty-direct --logo-width 24 --logo-height 12 --logo-padding-top 2 "$@"
