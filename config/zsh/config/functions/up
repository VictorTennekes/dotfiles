# Upgrade everything: `make update` in the dotfiles repo (pull, Homebrew or dnf
# + firmware check, zsh plugins, nvim plugins and Mason tools, re-link). check
# and dry-run only look at the package manager.
if [[ $1 == (help|--help) ]]; then
  print -P "%F{green}Usage:%f up [option]
  %F{yellow}check%f     Sanity-check the package manager
  %F{yellow}dry-run%f   Show what an upgrade would change
  %F{yellow}help%f      Show this help"
  return
fi
local -x NONINTERACTIVE=1
case $OSTYPE:$1 in
  darwin*:check)   brew doctor ;;
  darwin*:dry-run) brew update && brew upgrade --greedy --dry-run ;;
  linux*:check)    dnf check ;;
  linux*:dry-run)  dnf check-upgrade --refresh; return 0 ;;  # exits 100 when there are updates
  # The repo: .zshrc's real path is <repo>/config/zsh/.zshrc
  *:)              make --no-print-directory -C ${${:-$ZDOTDIR/.zshrc}:A:h:h:h} update ;;
  *)               up help; return 1 ;;
esac
