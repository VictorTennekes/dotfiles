{
  "permissions": {
    "allow": [
      "Bash(up)",
      "Bash(up *)",
      "Bash(brew update)",
      "Bash(brew outdated)",
      "Bash(brew outdated *)",
      "Bash(brew upgrade)",
      "Bash(brew upgrade *)",
      "Bash(brew cleanup)",
      "Bash(brew doctor)",
      "Bash(NONINTERACTIVE=1 brew update)",
      "Bash(NONINTERACTIVE=1 brew upgrade)",
      "Bash(NONINTERACTIVE=1 brew upgrade *)",
      "Bash(NONINTERACTIVE=1 brew cleanup)",
      "Bash(npm update -g)"
    ]
  },
  "model": "fable",
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "advisorModel": "opus",
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "skipAutoPermissionPrompt": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/victortennekes/Documents/code/personal/agent-workshop/hook.py"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/victortennekes/Documents/code/personal/agent-workshop/hook.py",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/victortennekes/Documents/code/personal/agent-workshop/hook.py"
          }
