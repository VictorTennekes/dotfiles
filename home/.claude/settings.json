{
  "permissions": {
    "allow": [
      "Bash(up)",
      "Bash(up *)",
      "Bash(brew update)",
      "Bash(brew outdated)",
      "Bash(brew outdated *)",
      "Bash(brew upgrade)",
      "Bash(brew upgrade *)",
      "Bash(brew cleanup)",
      "Bash(brew doctor)",
      "Bash(NONINTERACTIVE=1 brew update)",
      "Bash(NONINTERACTIVE=1 brew upgrade)",
      "Bash(NONINTERACTIVE=1 brew upgrade *)",
      "Bash(NONINTERACTIVE=1 brew cleanup)",
      "Bash(npm update -g)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "skillOverrides": {
    "anthropic-skills:artifact-emulator": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Documents/code/personal/agent-workshop/hook.py\"; [ -f \"$f\" ] && exec python3 \"$f\"; exit 0"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Documents/code/personal/agent-workshop/hook.py\"; [ -f \"$f\" ] && exec python3 \"$f\"; exit 0",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Documents/code/personal/agent-workshop/hook.py\"; [ -f \"$f\" ] && exec python3 \"$f\"; exit 0"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Documents/code/personal/agent-workshop/hook.py\"; [ -f \"$f\" ] && exec python3 \"$f\"; exit 0"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Documents/code/personal/agent-workshop/hook.py\"; [ -f \"$f\" ] && exec python3 \"$f\"; exit 0"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Documents/code/personal/agent-workshop/hook.py\"; [ -f \"$f\" ] && exec python3 \"$f\"; exit 0",
            "timeout": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Documents/code/personal/agent-workshop/hook.py\"; [ -f \"$f\" ] && exec python3 \"$f\"; exit 0"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Documents/code/personal/agent-workshop/hook.py\"; [ -f \"$f\" ] && exec python3 \"$f\"; exit 0"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Documents/code/personal/agent-workshop/hook.py\"; [ -f \"$f\" ] && exec python3 \"$f\"; exit 0"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "advisorModel": "opus",
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: not queryable here (gh returned \"not queryable here\" for VictorTennekes/dotfiles) — treat as possibly public per the unverified-visibility default: scope commits/pushes there as for a public repo",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: Default branch main; Protected branches: none listed; Rulesets: none listed (repo: VictorTennekes/dotfiles)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Source control**: The trusted repo (github.com:VictorTennekes/dotfiles.git) and its remote(s) only — no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (personal dotfiles management — Zsh, Neovim, Umbriel/Noctalia desktop config, Fedora/macOS system setup)",
      "**Trusted repo**: /home/victor/.dotfiles (remote github.com:VictorTennekes/dotfiles.git) — visibility unverified, treat as possibly public for commit/push scoping",
      "**Org-specific CLIs**: None configured"
    ]
  }
}
