# ==============================================================================
# PREAMBLE - Detect work laptop for conditional installs
# ==============================================================================
# Marker file (`touch ~/.work-laptop` once, on the work machine) — survives
# hostname renames, unlike matching on a hostname prefix.
is_work_laptop = File.exist?(File.expand_path('~/.work-laptop'))


# ==============================================================================
# CORE SYSTEM & COMMAND-LINE INTERFACE (CLI) TOOLS
# ==============================================================================
# Essential utilities for file management, searching, and development.

