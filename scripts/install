#!/bin/bash
# Symlinks dotfiles using GNU Stow: shared config/ plus this OS's config-<os>/.

set -e

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
PROJECT_ROOT=$(dirname "$SCRIPT_DIR")
# Status lines in setup's style (Unicode markers in ANSI colours)
ok()   { printf '\033[32m✓ %s\033[0m\n' "$*"; }
warn() { printf '\033[33m! %s\033[0m\n' "$*"; }

case "$(uname -s)" in
    Darwin) OS_CONFIG=config-macos ;;
    Linux)  OS_CONFIG=config-linux ;;
    *)      printf '\033[31m✗ Unsupported OS: %s\033[0m\n' "$(uname -s)"; exit 1 ;;
esac

# --- 1. Drop links left dangling by configs that moved or left the repo ---
# (e.g. ~/.config/ghostty -> config/ghostty after it moved to config-macos/).
# One level into ~/.config too: stow links files inside a dir it doesn't own.
{ find "$HOME" -maxdepth 1 -type l; find "$HOME/.config" -mindepth 1 -maxdepth 2 -type l
  find "$HOME/.claude" "$HOME/.local/share/applications" "$HOME/.local/share/fonts" -mindepth 1 -maxdepth 2 -type l; } 2>/dev/null |
    while read -r link; do [ -e "$link" ] || echo "$link"; done |
    while read -r link; do
        case "$(readlink "$link")" in
            *"$(basename "$PROJECT_ROOT")"/*) echo "  Removing stale link $link"; rm "$link" ;;
        esac
    done

# --- 2. Link config/ and config-<os>/ → ~/.config/ via stow ---
# (config/nvim is its own repo; scripts/setup clones it.)
mkdir -p "$HOME/.config"
stow -d "$PROJECT_ROOT" -t "$HOME/.config" config "$OS_CONFIG"

# --- 3. Link home/ → ~/ via stow ---
# ~/.claude and ~/.claude/skills must exist as real dirs first: Claude Code
# writes state next to the linked files (skills/synced, history, sessions),
# so stow has to link files into them, not fold the dirs into the repo.
# Same for ~/.local/share/fonts: fonts installed by hand must not land in
# the repo through a folded link (home/.local/share/fonts holds the
# unpackaged ones, one dir per family).
mkdir -p "$HOME/.claude/skills" "$HOME/.local/share/fonts"
stow -d "$PROJECT_ROOT" -t "$HOME" home

# --- 4. Agent skills: home/.agents/skills is the shared source (Agent Skills
# layout, ~/.agents/skills); Claude Code only reads ~/.claude/skills, so link
# each skill there. Absolute links into the repo so step 1 cleans them up.
for skill in "$PROJECT_ROOT"/home/.agents/skills/*/; do
    skill=${skill%/}
    dest="$HOME/.claude/skills/$(basename "$skill")"
    if [ -e "$dest" ] && [ ! -L "$dest" ]; then
        warn "$dest is a real directory; move it away to use the repo's copy"
        continue
    fi
    ln -sfn "$skill" "$dest"
done

# --- 5. Zen user.js: profile dirs have random names, so stow can't target
# them. Link into each install's default profile (profiles.ini Default=<path>;
# Default=1 marks the profile list's default, not a path).
zen_profiles() {
    local root
    for root in "$HOME/Library/Application Support/zen" "${XDG_CONFIG_HOME:-$HOME/.config}/zen" "$HOME/.zen"; do
        [ -f "$root/profiles.ini" ] || continue
        sed -n '/^Default=[01]$/!s/^Default=//p' "$root/profiles.ini" | sort -u |
            while read -r p; do [ -d "$root/$p" ] && echo "$root/$p"; done
    done
}
zen_profiles | while read -r profile; do
    dest="$profile/user.js"
    if [ -e "$dest" ] && [ ! -L "$dest" ]; then
        warn "$dest is a real file; move it away to use the repo's copy"
        continue
    fi
    ln -sfn "$PROJECT_ROOT/browser/zen/user.js" "$dest"
done

ok "Configs linked ($OS_CONFIG)"
