#!/bin/bash
# Symlinks dotfiles using GNU Stow: shared config/ plus this OS's config-<os>/.

set -e

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
PROJECT_ROOT=$(dirname "$SCRIPT_DIR")

case "$(uname -s)" in
    Darwin) OS_CONFIG=config-macos ;;
    Linux)  OS_CONFIG=config-linux ;;
    *)      echo "❌ Unsupported OS: $(uname -s)"; exit 1 ;;
esac

# --- 0. Clone nvim config if not present ---
NVIM_CONFIG_DIR="$PROJECT_ROOT/config/nvim"

if [ ! -d "$NVIM_CONFIG_DIR" ] || [ -z "$(ls -A "$NVIM_CONFIG_DIR" 2>/dev/null)" ]; then
    echo "📦 'nvim' config not found — cloning from GitHub..."
    rmdir "$NVIM_CONFIG_DIR" 2>/dev/null || true
    git clone https://github.com/victortennekes/nvim "$NVIM_CONFIG_DIR" || {
        echo "❌ Failed to clone nvim config."
    }
else
    echo "✅ 'nvim' config already exists. Skipping clone."
fi

# --- 1. Drop links left dangling by configs that moved inside the repo ---
# (e.g. ~/.config/ghostty -> config/ghostty after it moved to config-macos/).
# One level into ~/.config too: stow links files inside a dir it doesn't own.
{ find "$HOME" -maxdepth 1 -type l; find "$HOME/.config" -mindepth 1 -maxdepth 2 -type l; } 2>/dev/null |
    while read -r link; do [ -e "$link" ] || echo "$link"; done |
    while read -r link; do
        case "$(readlink "$link")" in
            *"$(basename "$PROJECT_ROOT")"/*) echo "🧹 Removing stale link $link"; rm "$link" ;;
        esac
    done

# --- 2. Link config/ and config-<os>/ → ~/.config/ via stow ---
echo "🔗 Linking config directories to ~/.config ($OS_CONFIG)..."
mkdir -p "$HOME/.config"
stow -d "$PROJECT_ROOT" -t "$HOME/.config" config "$OS_CONFIG"

# --- 3. Link home/ → ~/ via stow ---
echo "🔗 Linking home files to ~..."
stow -d "$PROJECT_ROOT" -t "$HOME" home

echo "✅ Done."
