#!/bin/bash
# Symlinks dotfiles using GNU Stow (macOS).

set -e

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
PROJECT_ROOT=$(dirname "$SCRIPT_DIR")

# --- 0. Clone nvim config if not present ---
NVIM_CONFIG_DIR="$PROJECT_ROOT/config/nvim"

if [ ! -d "$NVIM_CONFIG_DIR" ] || [ -z "$(ls -A "$NVIM_CONFIG_DIR" 2>/dev/null)" ]; then
    echo "📦 'nvim' config not found — cloning from GitHub..."
    rmdir "$NVIM_CONFIG_DIR" 2>/dev/null || true
    git clone https://github.com/victortennekes/nvim "$NVIM_CONFIG_DIR" || {
        echo "❌ Failed to clone nvim config."
    }
else
    echo "✅ 'nvim' config already exists. Skipping clone."
fi

# --- 0b. Install pokemon-colorscripts (not in Homebrew) ---
if ! command -v pokemon-colorscripts &>/dev/null; then
    echo "📦 'pokemon-colorscripts' not found — installing to ~/.local..."
    POKEMON_SRC="$HOME/.local/share/pokemon-colorscripts"
    git clone --depth 1 https://gitlab.com/phoneybadger/pokemon-colorscripts.git "$POKEMON_SRC" || {
        echo "❌ Failed to clone pokemon-colorscripts."
    }
    mkdir -p "$HOME/.local/bin"
    ln -sf "$POKEMON_SRC/pokemon-colorscripts.py" "$HOME/.local/bin/pokemon-colorscripts"
else
    echo "✅ 'pokemon-colorscripts' already installed. Skipping."
fi

# --- 1. Link config/ → ~/.config/ via stow ---
echo "🔗 Linking config directories to ~/.config..."
mkdir -p "$HOME/.config"
stow -d "$PROJECT_ROOT" -t "$HOME/.config" config

# --- 2. Link home/ → ~/ via stow ---
echo "🔗 Linking home files to ~..."
stow -d "$PROJECT_ROOT" -t "$HOME" home

echo "✅ Done."
