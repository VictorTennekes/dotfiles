#!/bin/bash
# The macOS firewall keys mosh-server's rule on its versioned Cellar path, so
# every brew upgrade (including protobuf rebuilds) leaves the new binary
# without a rule and phone connections hang. Re-allow it when missing.

set -e

FW=/usr/libexec/ApplicationFirewall/socketfilterfw
BIN=$(realpath /opt/homebrew/bin/mosh-server 2>/dev/null) || exit 0

# --getappblocked says "permitted" even for unknown apps; --listapps is truth.
if "$FW" --listapps | grep -A1 -F "$BIN " | grep -q 'Allow incoming'; then
  exit 0
fi

echo "🔓 Allowing $BIN through the macOS firewall (sudo)..."
sudo "$FW" --add "$BIN" >/dev/null
sudo "$FW" --unblockapp "$BIN" >/dev/null
