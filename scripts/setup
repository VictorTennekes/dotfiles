#!/bin/bash
# Guided, re-runnable setup for this machine (macOS or Fedora Linux). Every step
# checks first, fixes only what is missing, then re-checks. Steps that need a
# human (GUI apps, GitHub settings) pause with exact instructions.
#
#   scripts/setup          guided install / repair   (make install)
#   scripts/setup --check  report only, change nothing (make doctor)

set -uo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
CHECK_ONLY=0
[[ "${1:-}" == --check ]] && CHECK_ONLY=1
FAILED=0

KEY="$HOME/.ssh/id_ed25519"   # this machine's git key: auth + signing
SSHD_DROPIN=/etc/ssh/sshd_config.d/010-keys-only.conf

case "$(uname -s)" in
  Darwin) OS=macos ;;
  Linux)  [[ -f /etc/fedora-release ]] || { echo "✗ Only Fedora Linux is supported"; exit 1; }
          OS=fedora ;;
  *)      echo "✗ Unsupported OS: $(uname -s)"; exit 1 ;;
esac

# --- Bootstrap: everything below needs the package manager and gum -------------
if [[ $OS == macos ]]; then
  if ! xcode-select -p >/dev/null 2>&1; then
    (( CHECK_ONLY )) && { echo "✗ Command Line Tools missing"; exit 1; }
    echo "→ Installing Command Line Tools; finish the dialog, then re-run this script."
    xcode-select --install
    exit 1
  fi
  if ! command -v brew >/dev/null 2>&1 && [[ ! -x /opt/homebrew/bin/brew ]]; then
    (( CHECK_ONLY )) && { echo "✗ Homebrew missing"; exit 1; }
    echo "→ Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || exit 1
  fi
  eval "$(/opt/homebrew/bin/brew shellenv)"
  if ! command -v gum >/dev/null 2>&1; then
    (( CHECK_ONLY )) && { echo "✗ gum missing (run make install)"; exit 1; }
    brew install gum || exit 1
  fi
else
  if ! command -v gum >/dev/null 2>&1; then
    (( CHECK_ONLY )) && { echo "✗ gum missing (run make install)"; exit 1; }
    sudo dnf install -y gum || exit 1
  fi
fi

# Pipelines below use `grep ... >/dev/null`, never `grep -q`: with pipefail, -q's
# early exit can SIGPIPE the producer (curl, launchctl) into a false failure.

# --- UI helpers ----------------------------------------------------------------
# ANSI palette indices (0-15) only, so everything follows the terminal theme;
# gum's confirm buttons otherwise use fixed 256-color pink/grey.
export GUM_CONFIRM_PROMPT_FOREGROUND=4 \
  GUM_CONFIRM_SELECTED_FOREGROUND=0 GUM_CONFIRM_SELECTED_BACKGROUND=5 \
  GUM_CONFIRM_UNSELECTED_FOREGROUND=7 GUM_CONFIRM_UNSELECTED_BACKGROUND=8
ok()      { gum style --foreground 2 "  ✓ $*"; }
bad()     { gum style --foreground 1 "  ✗ $*"; }
section() { echo; gum style --bold --foreground 5 "$*"; }

# Show manual instructions and wait until the user confirms they're done.
manual() {
  gum style --border rounded --border-foreground 3 --padding "0 1" --margin "0 2" "$@"
  gum confirm "Done?" || { bad "stopped"; exit 1; }
}

# step <name> <check-fn> <fix-fn>: check; in guided mode fix and re-check.
step() {
  local name=$1 check=$2 fix=$3
  if $check; then ok "$name"; return 0; fi
  if (( CHECK_ONLY )); then bad "$name"; FAILED=1; return 1; fi
  gum style --foreground 4 "  → $name"
  $fix
  if $check; then ok "$name"; else bad "$name (still failing)"; FAILED=1; return 1; fi
}

pubkey() { awk '{print $1" "$2}' "$KEY.pub" 2>/dev/null; }
# Names this machine shows to GitHub/GitLab (key titles) and in key comments.
machine_name() { if [[ $OS == macos ]]; then scutil --get ComputerName; else hostnamectl hostname; fi; }
host_name()    { if [[ $OS == macos ]]; then scutil --get LocalHostName; else hostnamectl hostname; fi; }
gh_ok() { gh auth status >/dev/null 2>&1; }

# --- Checks and fixes ------------------------------------------------------------
check_packages() { brew bundle check --no-upgrade --file "$ROOT/packages/Brewfile" >/dev/null 2>&1; }
fix_packages()   { make -C "$ROOT" brew; }

# Fedora: Terra (Fyra Labs) for what the official repos lack. Its release
# package installs the repo file and signing key; the bootstrap is the
# documented one (https://terra.fyralabs.com). That first install is
# trust-on-first-use over HTTPS (--nogpgcheck): everything after it is
# verified against the key it installs.
check_terra() { rpm -q terra-release >/dev/null 2>&1; }
fix_terra() {
  sudo dnf install -y --nogpgcheck \
    --repofrompath 'terra,https://repos.fyralabs.com/terra$releasever' terra-release
}

# Package list without comments (whole-line or trailing), and the ones not
# installed yet. Weak deps off: niri alone would otherwise pull in alacritty
# and the rest of a sway-style desktop.
pkglist() { sed 's/#.*//' "$ROOT/packages/$1" | awk 'NF { print $1 }'; }
missing_pkgs() { comm -23 <(pkglist "$1" | sort) <(rpm -qa --qf '%{NAME}\n' | sort -u); }
# Listed packages that dnf considers removable (installed as a dependency or
# by the installer's group, not by the user).
not_user_installed() {
  pkglist fedora.txt | xargs dnf repoquery --installed --qf '%{name} %{reason}\n' 2>/dev/null |
    awk '$2 != "User" { print $1 }'
}
check_fedora_packages() { [[ -z "$(missing_pkgs fedora.txt)" && -z "$(not_user_installed)" ]]; }
# Install what's missing, and mark listed packages user-installed: some came
# in as dependencies of the base install, and dnf's cleanup (e.g. the trim
# below) would remove those. Only what needs changing goes to dnf, so re-runs
# stay quiet.
fix_fedora_packages() {
  missing_pkgs fedora.txt | xargs -r sudo dnf install -y --setopt=install_weak_deps=False &&
    not_user_installed | xargs -r sudo dnf mark user -y -q
}

# Fedora defaults this laptop doesn't need: crash reporting (abrt), a syslog
# next to the journal, modem support, at and cron (everything uses systemd
# timers), Kerberos/NFS/SMB and directory joining (sssd, realmd), smart cards,
# disk-health and process-accounting daemons, the daily `locate` index, mDNS,
# an SSH server listening on every network, AWS libraries the installer
# leaves behind, and
# firmware for hardware a Framework 13 AMD doesn't have (kept: amd-gpu,
# amd-ucode, mt7xxx for the Wi-Fi, realtek for USB-C Ethernet adapters).
# dnf also removes what only these pulled in.
TRIM=('abrt*' rsyslog ModemManager NetworkManager-wwan at gssproxy nfs-utils
      nfs-common-utils avahi openssh-server
      cronie cronie-anacron crontabs smartmontools mcelog psacct plocate sos
      sssd-kcm sssd-proxy realmd cifs-utils opensc quota dnsmasq
      python3-botocore python3-s3transfer python3-jmespath
      nvidia-gpu-firmware intel-gpu-firmware intel-audio-firmware
      intel-npu-firmware atheros-firmware brcmfmac-firmware tiwilink-firmware
      nxpwireless-firmware cirrus-audio-firmware qcom-wwan-firmware)
trimmed() { local p; for p in "${TRIM[@]}"; do rpm -qa "$p" | grep . >/dev/null && echo "$p"; done; }
check_trim() { [[ -z "$(trimmed)" ]]; }
fix_trim()   { trimmed | xargs sudo dnf remove -y; }

# Units this laptop doesn't use: portable home directories, and the weekly
# RAID check (mdadm itself stays: udisks2, which mounts USB drives, needs it).
DISABLED_UNITS=(systemd-homed.service raid-check.timer)
check_units_off() {
  local u; for u in "${DISABLED_UNITS[@]}"; do ! systemctl is-enabled -q "$u" 2>/dev/null || return 1; done
}
fix_units_off() { sudo systemctl disable --now "${DISABLED_UNITS[@]}"; }

# Bitwarden desktop isn't packaged anywhere trustworthy: the official AppImage
# (it updates itself), with a launcher and its icon. Extracting needs no FUSE.
BW_APP="$HOME/.local/opt/bitwarden.AppImage"
BW_URL="https://bitwarden.com/download/?app=desktop&platform=linux&variant=appimage"
BW_DESKTOP="$HOME/.local/share/applications/bitwarden.desktop"
BW_ICON="$HOME/.local/share/icons/bitwarden.png"
bw_desktop() {
  printf '%s\n' "[Desktop Entry]" "Type=Application" "Name=Bitwarden" \
    "Exec=$BW_APP %U" "Icon=$BW_ICON" "Categories=Utility;"
}
check_bitwarden() { [[ -x "$BW_APP" ]] && cmp -s <(bw_desktop) "$BW_DESKTOP"; }
# Downloads into a temp dir: a failed download leaves the installed AppImage
# and launcher alone; they're only replaced once everything worked.
fix_bitwarden() {
  local tmp; tmp=$(mktemp -d)
  mkdir -p "${BW_APP%/*}" "${BW_ICON%/*}" "${BW_DESKTOP%/*}"
  if curl -fsSL -o "$tmp/bw.AppImage" "$BW_URL" && chmod +x "$tmp/bw.AppImage" &&
     (cd "$tmp" && ./bw.AppImage --appimage-extract bitwarden.png >/dev/null &&
       ./bw.AppImage --appimage-extract "$(readlink squashfs-root/bitwarden.png)" >/dev/null) &&
     cp -L "$tmp/squashfs-root/bitwarden.png" "$BW_ICON" &&
     mv -f "$tmp/bw.AppImage" "$BW_APP"; then
    bw_desktop >"$BW_DESKTOP"
  fi
  rm -rf "$tmp"
}

# usermod, not chsh: Fedora ships chsh separately (util-linux-user).
check_shell() { [[ "$(getent passwd "$USER" | cut -d: -f7)" == /usr/bin/zsh ]]; }
fix_shell()   { sudo usermod -s /usr/bin/zsh "$USER"; }

# On macOS antidote comes from Homebrew; on Fedora it's a git clone.
ANTIDOTE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/antidote"
check_antidote() { [[ -r "$ANTIDOTE_DIR/antidote.zsh" ]]; }
fix_antidote()   { git clone --depth 1 https://github.com/mattmc3/antidote "$ANTIDOTE_DIR"; }

# /etc files tracked in system-linux/etc (zram, sysctl, journald, dnf without
# weak deps, SDDM, Wi-Fi backend); the tailscaled polkit rule has its own
# step below. Takes full
# effect after a reboot; nothing is restarted here (it could drop the network).
system_files() { (cd "$ROOT/system-linux" && find etc -type f); }
check_system_files() {
  local f; while read -r f; do cmp -s "$ROOT/system-linux/$f" "/$f" || return 1; done < <(system_files)
}
fix_system_files() {
  local f; while read -r f; do sudo install -Dm644 "$ROOT/system-linux/$f" "/$f"; done < <(system_files)
  sudo systemctl daemon-reload && sudo sysctl -q --system
}

SERVICES=(NetworkManager iwd systemd-resolved bluetooth power-profiles-daemon
          fstrim.timer sddm)
check_services() {
  local s; for s in "${SERVICES[@]}"; do systemctl is-enabled -q "$s" 2>/dev/null || return 1; done
  [[ "$(systemctl get-default)" == graphical.target ]]   # minimal installs boot to a TTY
}
fix_services() {
  sudo systemctl enable "${SERVICES[@]}"
  sudo systemctl set-default graphical.target
}

# Bluetooth daemon runs, but the radio stays off at boot; switch it on when
# needed (Waybar: right-click the icon, or bluetoothctl).
check_bt_off_at_boot() { grep -q '^AutoEnable=false' /etc/bluetooth/main.conf; }
fix_bt_off_at_boot() {
  sudo sed -i 's/^#\?AutoEnable=.*/AutoEnable=false/' /etc/bluetooth/main.conf
}

# Tailscale only runs when wanted: tailscaled isn't started at boot, and the
# Waybar toggle starts/stops it. A polkit rule lets wheel do that without a
# password. rules.d isn't readable by users, so the check asks systemd for a
# no-op instead (start if running, stop if stopped): it still has to pass the
# polkit check first, and fails rather than prompting.
TS_RULE=/etc/polkit-1/rules.d/50-tailscaled.rules
check_ts_on_demand() {
  # "activating" counts as running: stopping it would kill a toggle in progress
  local noop=stop
  case $(systemctl show -p ActiveState --value tailscaled) in
    active|activating|reloading) noop=start ;;
  esac
  ! systemctl is-enabled -q tailscaled 2>/dev/null &&
    systemctl --no-ask-password "$noop" tailscaled 2>/dev/null
}
fix_ts_on_demand() {
  sudo systemctl disable tailscaled
  sudo install -m644 "$ROOT/system-linux/polkit/50-tailscaled.rules" "$TS_RULE"
}

RESOLV_STUB=/run/systemd/resolve/stub-resolv.conf
check_resolv() { [[ "$(readlink -f /etc/resolv.conf)" == "$RESOLV_STUB" ]]; }
fix_resolv()   { sudo ln -sf "$RESOLV_STUB" /etc/resolv.conf; }

# Login screen: sddm-astronaut-theme (not packaged for Fedora: a git clone, plus
# its fonts) with the jake_the_dog variant, as its own theme dir of symlinks so
# theme updates (git pull) don't reset the chosen variant.
ASTRONAUT=/usr/share/sddm/themes/sddm-astronaut-theme
ASTRONAUT_FONTS=/usr/share/fonts/sddm-astronaut
JAKE=/usr/share/sddm/themes/astronaut-jake
check_sddm_theme() {
  [[ -d "$ASTRONAUT_FONTS" ]] &&
    grep -q '^ConfigFile=Themes/jake_the_dog.conf' "$JAKE/metadata.desktop" 2>/dev/null
}
fix_sddm_theme() {
  [[ -d "$ASTRONAUT/.git" ]] ||
    sudo git clone --depth 1 https://github.com/Keyitdev/sddm-astronaut-theme "$ASTRONAUT"
  sudo mkdir -p "$ASTRONAUT_FONTS" && sudo cp -r "$ASTRONAUT/Fonts/." "$ASTRONAUT_FONTS/"
  sudo fc-cache -f "$ASTRONAUT_FONTS" >/dev/null
  sudo mkdir -p "$JAKE"
  local f; for f in "$ASTRONAUT"/*; do sudo ln -sfn "$f" "$JAKE/"; done
  sudo rm -f "$JAKE/metadata.desktop"
  sed -e 's|^ConfigFile=.*|ConfigFile=Themes/jake_the_dog.conf|' -e 's|^Name=.*|Name=Astronaut (Jake)|' \
    "$ASTRONAUT/metadata.desktop" | sudo tee "$JAKE/metadata.desktop" >/dev/null
}

# gnome-keyring through its systemd user socket: that socket is the control
# channel the login screen (pam_gnome_keyring) uses to hand over the password
# and unlock the "login" keyring. Without it the daemon gets started by D-Bus
# instead, with no control socket, and every app asks to unlock the keyring.
check_keyring_socket() { systemctl --user is-enabled -q gnome-keyring-daemon.socket 2>/dev/null; }
fix_keyring_socket()   { systemctl --user enable gnome-keyring-daemon.socket; }

# Dark mode: GTK4/libadwaita and Electron apps (Bitwarden, Zen) follow
# color-scheme, read through the desktop portal; GTK3 apps need the dark theme.
gs() { gsettings get org.gnome.desktop.interface "$1" 2>/dev/null; }
check_dark_mode() { [[ "$(gs color-scheme)" == "'prefer-dark'" && "$(gs gtk-theme)" == "'adw-gtk3-dark'" ]]; }
fix_dark_mode() {
  gsettings set org.gnome.desktop.interface color-scheme prefer-dark
  gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark
}

# Wallpaper for swaybg and swaylock (images aren't in the repo).
WALLPAPER="$HOME/Pictures/Wallpapers/current"
check_wallpaper() { [[ -e "$WALLPAPER" ]]; }
fix_wallpaper() {
  manual "Put wallpapers in ~/Pictures/Wallpapers, then pick one:" \
    "ln -sfn <file> ~/Pictures/Wallpapers/current"
}

# A stow dry run prints a LINK (or conflict) line for anything not linked yet.
check_links() {
  command -v stow >/dev/null || return 1
  local os_config=config-linux out
  [[ $OS == macos ]] && os_config=config-macos
  out=$({ stow -n -v -d "$ROOT" -t "$HOME/.config" config "$os_config"
          stow -n -v -d "$ROOT" -t "$HOME" home; } 2>&1)
  ! grep -E '^LINK|conflict' <<<"$out" >/dev/null
}
fix_links() { bash "$ROOT/scripts/install"; }

# One plain key file per machine. It works while the screen is locked, which
# unattended use (T3 Code, phone sessions) needs; Secure Enclave keys don't.
check_ssh_key() { [[ -f "$KEY" && -f "$KEY.pub" ]]; }
fix_ssh_key() {
  mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
  ssh-keygen -q -t ed25519 -N "" -C "$USER@$(host_name)" -f "$KEY"
}

# GitHub keys are checked via GitHub's public key endpoints (no token scopes
# needed); the username comes from a test login with the key.
GH_USER=""
github_user() {
  ssh -T -o IdentitiesOnly=yes -i "$KEY" git@github.com 2>&1 | sed -n 's/^Hi \([^!]*\)!.*/\1/p'
}
# Anonymous API calls are capped at 60/hour; go through gh when it's logged in
# (5000/hour, public key lists need no extra scopes, and the token stays off
# the command line).
github_get() {
  if gh_ok; then gh api "$1" 2>/dev/null
  else curl -fsS "https://api.github.com/$1" 2>/dev/null; fi
}
github_rate_limited() {
  github_get rate_limit | jq -e '.resources.core.remaining == 0' >/dev/null
}
github_has() { # <keys|ssh_signing_keys>
  github_get "users/$GH_USER/$1" | grep -F "$(pubkey | awk '{print $2}')" >/dev/null
}
check_github_keys() {
  # GitHub's SSH endpoint occasionally drops a connection; retry once.
  [[ -n "$GH_USER" ]] || GH_USER=$(github_user)
  [[ -n "$GH_USER" ]] || { sleep 2; GH_USER=$(github_user); }
  [[ -n "$GH_USER" ]] && github_has keys && github_has ssh_signing_keys
}
fix_github_keys() {
  # Managing keys needs two scopes a default gh login doesn't have.
  local scopes=admin:public_key,admin:ssh_signing_key
  if ! gh_ok; then
    gh auth login -h github.com -s "$scopes"
  elif ! gh api user/ssh_signing_keys >/dev/null 2>&1; then
    gh auth refresh -h github.com -s "$scopes"
  fi
  GH_USER=$(gh api user --jq .login)
  local title; title=$(machine_name)
  github_has keys || gh ssh-key add "$KEY.pub" --type authentication --title "$title"
  github_has ssh_signing_keys || gh ssh-key add "$KEY.pub" --type signing --title "$title"
}

glab_ok() { glab auth status >/dev/null 2>&1; }
gitlab_has() { glab ssh-key list 2>/dev/null | grep -F "$(pubkey | awk '{print $2}')" >/dev/null; }
check_gitlab_keys() { glab_ok && gitlab_has; }
fix_gitlab_keys() {
  glab_ok || glab auth login -h gitlab.com
  gitlab_has || glab ssh-key add "$KEY.pub" -t "$(machine_name)" --usage-type auth_and_signing
}

check_signing() {
  [[ "$(git config --file "$HOME/.gitconfig.local" user.signingkey)" == "$KEY" ]] &&
    grep -qF "$(git config user.email) $(pubkey)" "$HOME/.ssh/allowed_signers" 2>/dev/null
}
fix_signing() {
  git config --file "$HOME/.gitconfig.local" user.signingkey "$KEY"
  local line; line="$(git config user.email) $(pubkey)"
  grep -qF "$line" "$HOME/.ssh/allowed_signers" 2>/dev/null || echo "$line" >>"$HOME/.ssh/allowed_signers"
}

# gh as git's HTTPS credential helper. Per machine: it needs gh's absolute path
# (macOS GUI apps lack Homebrew on PATH, and the path differs per OS).
GH_HOSTS=(https://github.com https://gist.github.com)
check_gh_helper() {
  local h; for h in "${GH_HOSTS[@]}"; do
    git config --file "$HOME/.gitconfig.local" --get-all "credential.$h.helper" 2>/dev/null |
      grep -Fx "!$(command -v gh) auth git-credential" >/dev/null || return 1
  done
}
fix_gh_helper() {
  command -v gh >/dev/null || { bad "gh isn't installed"; return 1; }
  local h; for h in "${GH_HOSTS[@]}"; do
    # The empty helper clears any inherited ones.
    git config --file "$HOME/.gitconfig.local" --replace-all "credential.$h.helper" ""
    git config --file "$HOME/.gitconfig.local" --add "credential.$h.helper" "!$(command -v gh) auth git-credential"
  done
}

check_remote_login() { nc -z -G 1 localhost 22 >/dev/null 2>&1; }
fix_remote_login() {
  open "x-apple.systempreferences:com.apple.Sharing-Settings.extension"
  manual "System Settings → General → Sharing: turn on Remote Login."
}

check_sshd_keys_only() {
  grep -x 'PasswordAuthentication no' "$SSHD_DROPIN" >/dev/null 2>&1 &&
    grep -x 'KbdInteractiveAuthentication no' "$SSHD_DROPIN" >/dev/null 2>&1
}
fix_sshd_keys_only() {
  printf '%s\n' "# Remote Login answers on every network; only allow key-based logins." \
    "PasswordAuthentication no" "KbdInteractiveAuthentication no" | sudo tee "$SSHD_DROPIN" >/dev/null
  sudo sshd -t || { sudo rm -f "$SSHD_DROPIN"; bad "sshd rejected the config, removed it"; }
}

check_authorized_keys() { [[ -s "$HOME/.ssh/authorized_keys" ]]; }
fix_authorized_keys() {
  manual "Termius (phone): Keychain → generate an ed25519 key → Export to host," \
    "or paste its public key as a line in ~/.ssh/authorized_keys."
}

ts_prefs() { tailscale debug prefs 2>/dev/null; }
check_tailscale() {
  pgrep -x tailscaled >/dev/null && ! tailscale status 2>&1 | grep -iE 'logged out|NeedsLogin' >/dev/null
}
fix_tailscale() {
  if [[ $OS == macos ]]; then sudo brew services start tailscale
  else sudo systemctl start tailscaled; fi   # not enabled: on demand
  manual "Run 'sudo tailscale up' in another terminal and finish the login in the browser."
}

check_ts_operator() { ts_prefs | grep "\"OperatorUser\": \"$USER\"" >/dev/null; }
fix_ts_operator()   { sudo tailscale set --operator="$USER"; }

# Stay awake on the charger only (display still sleeps and locks), so the Mac
# is always reachable when plugged in and battery life is untouched.
ac_sleep() { pmset -g custom | awk '/Power:$/{s=$0} s=="AC Power:" && $1=="sleep"{print $2}'; }
check_ac_awake() { [[ "$(ac_sleep)" == 0 ]]; }
fix_ac_awake()   { sudo pmset -c sleep 0; }

check_swiftbar() {
  [[ "$(defaults read com.ameba.SwiftBar PluginDirectory 2>/dev/null)" == "$HOME/.config/swiftbar" ]]
}
fix_swiftbar() {
  defaults write com.ameba.SwiftBar PluginDirectory -string "$HOME/.config/swiftbar"
  open -a SwiftBar
  manual "SwiftBar → Preferences: enable 'Launch at login'."
}

# --- Run -------------------------------------------------------------------------
gum style --border double --border-foreground 5 --padding "0 2" \
  "dotfiles setup" "$( (( CHECK_ONLY )) && echo 'check only, no changes' || echo 'guided install')"

section "Base"
if [[ $OS == macos ]]; then
  if (( ! CHECK_ONLY )) && [[ ! -f "$HOME/.work-laptop" ]] &&
     gum confirm --default=false "Is this the work laptop? (installs work packages)"; then
    touch "$HOME/.work-laptop"
  fi
  step "Homebrew packages"        check_packages        fix_packages
  step "Config symlinks (stow)"   check_links           fix_links
  if (( ! CHECK_ONLY )) && gum confirm --default=false "Apply macOS defaults (Dock, Finder, keyboard)?"; then
    bash "$ROOT/scripts/macos-defaults"
  fi
else
  step "Terra repo"               check_terra           fix_terra
  step "Packages (dnf)"           check_fedora_packages fix_fedora_packages
  step "Bitwarden (AppImage)"     check_bitwarden       fix_bitwarden
  step "Fedora defaults trimmed"  check_trim            fix_trim
  step "Unused units off"         check_units_off       fix_units_off
  step "Config symlinks (stow)"   check_links           fix_links
  step "Login shell zsh"          check_shell           fix_shell
  step "antidote (zsh plugins)"   check_antidote        fix_antidote

  section "System"
  step "System files (/etc)"      check_system_files    fix_system_files
  step "Services enabled"         check_services        fix_services
  step "Bluetooth off at boot"    check_bt_off_at_boot  fix_bt_off_at_boot
  step "Tailscale on demand"      check_ts_on_demand    fix_ts_on_demand
  step "DNS via systemd-resolved" check_resolv          fix_resolv
  step "Login screen theme"       check_sddm_theme      fix_sddm_theme
  step "Dark mode (GTK, portal)"  check_dark_mode       fix_dark_mode
  step "Keyring unlocked at login" check_keyring_socket fix_keyring_socket
  step "Wallpaper"                check_wallpaper       fix_wallpaper
fi

section "Git key"
step "SSH key (.ssh/id_ed25519)" check_ssh_key fix_ssh_key &&
if github_rate_limited; then
  gum style --foreground 3 "  ? Keys on GitHub (API rate limit hit, try again later)"
else
  step "Keys on GitHub (auth + signing)" check_github_keys fix_github_keys
fi &&
if ! command -v glab >/dev/null; then
  gum style --foreground 3 "  - Keys on GitLab (glab not installed here)"
elif (( CHECK_ONLY )) && ! glab_ok; then
  gum style --foreground 3 "  ? Keys on GitLab (can't check: glab not logged in here)"
else
  step "Keys on GitLab (auth + signing)" check_gitlab_keys fix_gitlab_keys
fi &&
step "Commit signing + allowed_signers" check_signing fix_signing
step "gh as git credential helper"      check_gh_helper fix_gh_helper

section "Remote access"
if [[ $OS == macos ]]; then
  step "Remote Login on"          check_remote_login    fix_remote_login
  step "sshd keys-only"           check_sshd_keys_only  fix_sshd_keys_only
  step "authorized_keys present"  check_authorized_keys fix_authorized_keys
fi
if [[ $OS == fedora ]] && ! systemctl is-active -q tailscaled; then
  # Off by design until toggled from Waybar; its state can't be read meanwhile.
  gum style --foreground 3 "  - Tailscale (off; start it from the Waybar icon)"
else
  step "Tailscale logged in"      check_tailscale       fix_tailscale &&
  step "Tailscale operator"       check_ts_operator     fix_ts_operator
fi
if [[ $OS == macos ]]; then
  step "Awake on charger"         check_ac_awake        fix_ac_awake
  step "SwiftBar plugin folder"   check_swiftbar        fix_swiftbar
fi

# Private overlay (work config etc.) lives in a separate, private repo.
if [[ -x "$HOME/.dotfiles-private/setup" ]]; then
  section "Private overlay"
  "$HOME/.dotfiles-private/setup" "$@" || FAILED=1
fi

echo
if (( FAILED )); then bad "Some checks failed."; exit 1; fi
ok "All good."
