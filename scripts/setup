#!/bin/bash
# Guided, re-runnable setup for this Mac. Every step checks first, fixes only
# what is missing, then re-checks. Steps that need a human (GUI apps, GitHub
# settings) pause with exact instructions.
#
#   scripts/setup          guided install / repair   (make install)
#   scripts/setup --check  report only, change nothing (make doctor)

set -uo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
CHECK_ONLY=0
[[ "${1:-}" == --check ]] && CHECK_ONLY=1
FAILED=0

KEY="$HOME/.ssh/id_ed25519"   # this machine's git key: auth + signing
SSHD_DROPIN=/etc/ssh/sshd_config.d/010-keys-only.conf

# --- Bootstrap: everything below needs Homebrew and gum -----------------------
if ! xcode-select -p >/dev/null 2>&1; then
  (( CHECK_ONLY )) && { echo "✗ Command Line Tools missing"; exit 1; }
  echo "→ Installing Command Line Tools; finish the dialog, then re-run this script."
  xcode-select --install
  exit 1
fi
if ! command -v brew >/dev/null 2>&1 && [[ ! -x /opt/homebrew/bin/brew ]]; then
  (( CHECK_ONLY )) && { echo "✗ Homebrew missing"; exit 1; }
  echo "→ Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || exit 1
fi
eval "$(/opt/homebrew/bin/brew shellenv)"
if ! command -v gum >/dev/null 2>&1; then
  (( CHECK_ONLY )) && { echo "✗ gum missing (run make install)"; exit 1; }
  brew install gum || exit 1
fi

# Pipelines below use `grep ... >/dev/null`, never `grep -q`: with pipefail, -q's
# early exit can SIGPIPE the producer (curl, launchctl) into a false failure.

# --- UI helpers ----------------------------------------------------------------
# ANSI palette indices (0-15) only, so everything follows the terminal theme;
# gum's confirm buttons otherwise use fixed 256-color pink/grey.
export GUM_CONFIRM_PROMPT_FOREGROUND=4 \
  GUM_CONFIRM_SELECTED_FOREGROUND=0 GUM_CONFIRM_SELECTED_BACKGROUND=5 \
  GUM_CONFIRM_UNSELECTED_FOREGROUND=7 GUM_CONFIRM_UNSELECTED_BACKGROUND=8
ok()      { gum style --foreground 2 "  ✓ $*"; }
bad()     { gum style --foreground 1 "  ✗ $*"; }
section() { echo; gum style --bold --foreground 5 "$*"; }

# Show manual instructions and wait until the user confirms they're done.
manual() {
  gum style --border rounded --border-foreground 3 --padding "0 1" --margin "0 2" "$@"
  gum confirm "Done?" || { bad "stopped"; exit 1; }
}

# step <name> <check-fn> <fix-fn>: check; in guided mode fix and re-check.
step() {
  local name=$1 check=$2 fix=$3
  if $check; then ok "$name"; return 0; fi
  if (( CHECK_ONLY )); then bad "$name"; FAILED=1; return 1; fi
  gum style --foreground 4 "  → $name"
  $fix
  if $check; then ok "$name"; else bad "$name (still failing)"; FAILED=1; return 1; fi
}

pubkey() { awk '{print $1" "$2}' "$KEY.pub" 2>/dev/null; }
gh_ok() { gh auth status >/dev/null 2>&1; }

# --- Checks and fixes ------------------------------------------------------------
check_packages() { brew bundle check --no-upgrade --file "$ROOT/packages/Brewfile" >/dev/null 2>&1; }
fix_packages()   { make -C "$ROOT" brew; }

check_links() {
  [[ -L "$HOME/.zshenv" && -L "$HOME/.config/zsh" ]]
}
fix_links() { bash "$ROOT/scripts/install" && make -C "$ROOT" zcompile; }

# One plain key file per machine. It works while the screen is locked, which
# unattended use (T3 Code, phone sessions) needs; Secure Enclave keys don't.
check_ssh_key() { [[ -f "$KEY" && -f "$KEY.pub" ]]; }
fix_ssh_key() {
  mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
  ssh-keygen -q -t ed25519 -N "" -C "$USER@$(scutil --get LocalHostName)" -f "$KEY"
}

# GitHub keys are checked via GitHub's public key endpoints (no token scopes
# needed); the username comes from a test login with the key.
GH_USER=""
github_user() {
  ssh -T -o IdentitiesOnly=yes -i "$KEY" git@github.com 2>&1 | sed -n 's/^Hi \([^!]*\)!.*/\1/p'
}
# Anonymous API calls are capped at 60/hour; use gh's token when it has one
# (5000/hour, and public key lists need no extra scopes).
github_get() {
  local token; token=$(gh auth token 2>/dev/null)
  curl -fsS ${token:+-H "Authorization: Bearer $token"} "https://api.github.com/$1" 2>/dev/null
}
github_rate_limited() {
  github_get rate_limit | jq -e '.resources.core.remaining == 0' >/dev/null
}
github_has() { # <keys|ssh_signing_keys>
  github_get "users/$GH_USER/$1" | grep -F "$(pubkey | awk '{print $2}')" >/dev/null
}
check_github_keys() {
  # GitHub's SSH endpoint occasionally drops a connection; retry once.
  [[ -n "$GH_USER" ]] || GH_USER=$(github_user)
  [[ -n "$GH_USER" ]] || { sleep 2; GH_USER=$(github_user); }
  [[ -n "$GH_USER" ]] && github_has keys && github_has ssh_signing_keys
}
fix_github_keys() {
  # Managing keys needs two scopes a default gh login doesn't have.
  local scopes=admin:public_key,admin:ssh_signing_key
  if ! gh_ok; then
    gh auth login -h github.com -s "$scopes"
  elif ! gh api user/ssh_signing_keys >/dev/null 2>&1; then
    gh auth refresh -h github.com -s "$scopes"
  fi
  GH_USER=$(gh api user --jq .login)
  local title; title=$(scutil --get ComputerName)
  github_has keys || gh ssh-key add "$KEY.pub" --type authentication --title "$title"
  github_has ssh_signing_keys || gh ssh-key add "$KEY.pub" --type signing --title "$title"
}

glab_ok() { glab auth status >/dev/null 2>&1; }
gitlab_has() { glab ssh-key list 2>/dev/null | grep -F "$(pubkey | awk '{print $2}')" >/dev/null; }
check_gitlab_keys() { glab_ok && gitlab_has; }
fix_gitlab_keys() {
  glab_ok || glab auth login -h gitlab.com
  gitlab_has || glab ssh-key add "$KEY.pub" -t "$(scutil --get ComputerName)" --usage-type auth_and_signing
}

check_signing() {
  [[ "$(git config --file "$HOME/.gitconfig.local" user.signingkey)" == "$KEY" ]] &&
    grep -qF "$(git config user.email) $(pubkey)" "$HOME/.ssh/allowed_signers" 2>/dev/null
}
fix_signing() {
  git config --file "$HOME/.gitconfig.local" user.signingkey "$KEY"
  local line; line="$(git config user.email) $(pubkey)"
  grep -qF "$line" "$HOME/.ssh/allowed_signers" 2>/dev/null || echo "$line" >>"$HOME/.ssh/allowed_signers"
}

check_remote_login() { nc -z -G 1 localhost 22 >/dev/null 2>&1; }
fix_remote_login() {
  open "x-apple.systempreferences:com.apple.Sharing-Settings.extension"
  manual "System Settings → General → Sharing: turn on Remote Login."
}

check_sshd_keys_only() { [[ -f "$SSHD_DROPIN" ]]; }
fix_sshd_keys_only() {
  printf '%s\n' "# Remote Login answers on every network; only allow key-based logins." \
    "PasswordAuthentication no" "KbdInteractiveAuthentication no" | sudo tee "$SSHD_DROPIN" >/dev/null
  sudo sshd -t || { sudo rm -f "$SSHD_DROPIN"; bad "sshd rejected the config, removed it"; }
}

check_authorized_keys() { [[ -s "$HOME/.ssh/authorized_keys" ]]; }
fix_authorized_keys() {
  manual "Termius (phone): Keychain → generate an ed25519 key → Export to host," \
    "or paste its public key as a line in ~/.ssh/authorized_keys."
}

ts_prefs() { tailscale debug prefs 2>/dev/null; }
check_tailscale() {
  pgrep -x tailscaled >/dev/null && ! tailscale status 2>&1 | grep -iE 'logged out|NeedsLogin' >/dev/null
}
fix_tailscale() {
  sudo brew services start tailscale
  manual "Run 'sudo tailscale up' in another terminal and finish the login in the browser."
}

check_ts_operator() { ts_prefs | grep "\"OperatorUser\": \"$USER\"" >/dev/null; }
fix_ts_operator()   { sudo tailscale set --operator="$USER"; }

# Stay awake on the charger only (display still sleeps and locks), so the Mac
# is always reachable when plugged in and battery life is untouched.
ac_sleep() { pmset -g custom | awk '/Power:$/{s=$0} s=="AC Power:" && $1=="sleep"{print $2}'; }
check_ac_awake() { [[ "$(ac_sleep)" == 0 ]]; }
fix_ac_awake()   { sudo pmset -c sleep 0; }

check_swiftbar() {
  [[ "$(defaults read com.ameba.SwiftBar PluginDirectory 2>/dev/null)" == "$HOME/.config/swiftbar" ]]
}
fix_swiftbar() {
  defaults write com.ameba.SwiftBar PluginDirectory -string "$HOME/.config/swiftbar"
  open -a SwiftBar
  manual "SwiftBar → Preferences: enable 'Launch at login'."
}

# --- Run -------------------------------------------------------------------------
gum style --border double --border-foreground 5 --padding "0 2" \
  "dotfiles setup" "$( (( CHECK_ONLY )) && echo 'check only, no changes' || echo 'guided install')"

section "Base"
if (( ! CHECK_ONLY )) && [[ ! -f "$HOME/.work-laptop" ]] &&
   gum confirm --default=false "Is this the work laptop? (installs work packages)"; then
  touch "$HOME/.work-laptop"
fi
step "Homebrew packages"        check_packages        fix_packages
step "Config symlinks (stow)"   check_links           fix_links
if (( ! CHECK_ONLY )) && gum confirm --default=false "Apply macOS defaults (Dock, Finder, keyboard)?"; then
  bash "$ROOT/scripts/macos-defaults"
fi

section "Git key"
step "SSH key (.ssh/id_ed25519)" check_ssh_key fix_ssh_key &&
if github_rate_limited; then
  gum style --foreground 3 "  ? Keys on GitHub (API rate limit hit, try again later)"
else
  step "Keys on GitHub (auth + signing)" check_github_keys fix_github_keys
fi &&
if (( CHECK_ONLY )) && ! glab_ok; then
  gum style --foreground 3 "  ? Keys on GitLab (can't check: glab not logged in here)"
else
  step "Keys on GitLab (auth + signing)" check_gitlab_keys fix_gitlab_keys
fi &&
step "Commit signing + allowed_signers" check_signing fix_signing

section "Remote access"
step "Remote Login on"          check_remote_login    fix_remote_login
step "sshd keys-only"           check_sshd_keys_only  fix_sshd_keys_only
step "authorized_keys present"  check_authorized_keys fix_authorized_keys
step "Tailscale logged in"      check_tailscale       fix_tailscale &&
step "Tailscale operator"       check_ts_operator     fix_ts_operator
step "Awake on charger"         check_ac_awake        fix_ac_awake
step "SwiftBar plugin folder"   check_swiftbar        fix_swiftbar

# Private overlay (work config etc.) lives in a separate, private repo.
if [[ -x "$HOME/.dotfiles-private/setup" ]]; then
  section "Private overlay"
  "$HOME/.dotfiles-private/setup" "$@" || FAILED=1
fi

echo
if (( FAILED )); then bad "Some checks failed."; exit 1; fi
ok "All good."
