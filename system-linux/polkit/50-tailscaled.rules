// Let admins (wheel) start/stop tailscaled without a password, so the Waybar
// Tailscale toggle can run the daemon only while it's needed. Only this unit,
// only start/stop. Installed to /etc/polkit-1/rules.d by scripts/setup.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "tailscaled.service" &&
        (action.lookup("verb") == "start" || action.lookup("verb") == "stop") &&
        subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
